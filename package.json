{
  "name": "sarlifier",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:wasm": "engine/build-wasm.sh",
    "build:worklet": "vite build --config vite.worklet.config.ts",
    "test:cpp": "cmake -S engine -B engine/build-host && cmake --build engine/build-host && ctest --test-dir engine/build-host --output-on-failure",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:licenses": "node scripts/gen-licenses.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
